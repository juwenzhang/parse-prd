  "userStories": [
    {
      "id": "US1",
      "role": "主播",
      "goal": "通过手机或电脑快速开播，设置直播信息并完成倒计时准备",
      "reason": "提高效率",
      "acceptanceCriteria": [
        "可以上传封面图并填写标题",
        "开播前显示3秒倒计时",
        "直播推流稳定，延迟低于3秒"
      ]
    },
    {
      "id": "US2",
      "role": "观众",
      "goal": "在直播间发送弹幕与主播互动",
      "reason": "提高效率",
      "acceptanceCriteria": [
        "弹幕实时出现在屏幕上",
        "弹幕过多时长时能正常显示",
        "包含敏感词的弹幕被拦截"
      ]
    },
    {
      "id": "US3",
      "role": "观众",
      "goal": "点击商品卡后在直播间浮层内选择规格并下单购买",
      "reason": "提高效率",
      "acceptanceCriteria": [
        "浮层内可展示商品详情和SKU选项",
        "库存实时校验，超卖时提示",
        "可正常使用优惠券"
      ]
    },
    {
      "id": "US4",
      "role": "主播",
      "goal": "讲解商品时将其卡片高亮，并可查看实时销售数据",
      "reason": "提高效率",
      "acceptanceCriteria": [
        "当前讲解商品卡片有明显高亮效果",
        "后台实时更新在线人数、成交额等数据"
      ]
    }
  ],
