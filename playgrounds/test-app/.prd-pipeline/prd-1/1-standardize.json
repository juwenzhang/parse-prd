  "functionalRequirements": [
    {
      "id": "FR1",
      "title": "未命名需求",
      "description": "主播可通过手机或电脑开启直播，设置标题、上传封面图，正式开播前显示倒计时准备界面。",
      "priority": "P2",
      "acceptanceCriteria": [],
      "dependencies": []
    },
    {
      "id": "FR2",
      "title": "未命名需求",
      "description": "主播在直播中可推送商品卡片到直播间，讲解时高亮当前讲解商品，观众点击卡片可查看详情并跳转购买。",
      "priority": "P2",
      "acceptanceCriteria": [],
      "dependencies": []
    },
    {
      "id": "FR3",
      "title": "未命名需求",
      "description": "观众可实时发送弹幕，弹幕在直播画面滚动显示；主播端可实时查看弹幕，并可置顶某条弹幕以便回复。",
      "priority": "P2",
      "acceptanceCriteria": [],
      "dependencies": []
    },
    {
      "id": "FR4",
      "title": "未命名需求",
      "description": "观众点击商品卡后在直播间内弹出购买浮层，支持选择SKU、校验库存，并可使用优惠券，完成不跳页下单。",
      "priority": "P2",
      "acceptanceCriteria": [],
      "dependencies": []
    },
    {
      "id": "FR5",
      "title": "未命名需求",
      "description": "主播端可查看实时直播数据，包括在线人数、商品点击量、成交额、新增粉丝，以及打赏/购买排行榜，刺激消费。",
      "priority": "P2",
      "acceptanceCriteria": [],
      "dependencies": []
    },
    {
      "id": "FR6",
      "title": "未命名需求",
      "description": "系统对弹幕进行限流和敏感词过滤，避免刷屏并拦截不当内容。",
      "priority": "P2",
      "acceptanceCriteria": [],
      "dependencies": []
    }
  ],
