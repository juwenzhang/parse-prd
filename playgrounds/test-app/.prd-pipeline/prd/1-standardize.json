  "overview": "",
  "background": "当前系统缺少完整的订单管理能力，用户反馈下单后无法查看订单状态，退款流程不透明、效率低，客服压力大。",
  "scope": {
    "inScope": [],
    "outOfScope": []
  },
  "functionalRequirements": [
    {
      "id": "FR-01",
      "title": "未命名需求",
      "description": "用户可提交包含多件商品的订单，并支持为不同商品指定不同收货地址。",
      "priority": "P2",
      "acceptanceCriteria": [],
      "dependencies": []
    },
    {
      "id": "FR-02",
      "title": "未命名需求",
      "description": "系统实时更新并展示订单状态，用户可在「我的订单」中查看所有历史订单。",
      "priority": "P2",
      "acceptanceCriteria": [],
      "dependencies": []
    },
    {
      "id": "FR-03",
      "title": "未命名需求",
      "description": "用户可在发货前主动取消订单，取消后系统自动发起退款。",
      "priority": "P2",
      "acceptanceCriteria": [],
      "dependencies": []
    },
    {
      "id": "FR-04",
      "title": "未命名需求",
      "description": "提供退款申请与处理功能，支持部分退款和自动/人工审核。",
      "priority": "P2",
      "acceptanceCriteria": [],
      "dependencies": []
    },
    {
      "id": "FR-05",
      "title": "未命名需求",
      "description": "用户收货后可对商品进行评分和文字评价，评价支持内容审核。",
      "priority": "P2",
      "acceptanceCriteria": [],
      "dependencies": []
    },
    {
      "id": "FR-06",
      "title": "未命名需求",
      "description": "运营人员可通过后台管理界面审核退款申请并查看退款日志。",
      "priority": "P2",
      "acceptanceCriteria": [],
      "dependencies": []
    }
  ],
  "nonFunctionalRequirements": [
    {
      "id": "NFR-1",
      "category": "performance",
      "description": "高可用：大促期间订单接口响应时间<500ms，并发支持≥10,000 QPS。",
      "metric": "待定义"
    },
    {
      "id": "NFR-2",
      "category": "performance",
      "description": "数据一致性：库存扣减与订单生成必须原子化，避免超卖。",
      "metric": "待定义"
    },
    {
      "id": "NFR-3",
      "category": "performance",
      "description": "可追溯：所有退款操作需记录完整日志，包含操作人、时间、金额、状态变更。",
      "metric": "待定义"
    },
    {
      "id": "NFR-4",
      "category": "performance",
      "description": "数据保留：线上订单数据保留2年，归档数据可离线查询。",
      "metric": "待定义"
    }
  ],
  "userStories": [
    {
      "id": "US-01",
      "role": "购物用户",
      "goal": "在选择多件商品后，能一次性填写多个收货地址并生成一张订单",
      "reason": "提高效率",
      "acceptanceCriteria": []
    },
    {
      "id": "US-02",
      "role": "普通买家",
      "goal": "能实时知道订单当前处于什么状态",
      "reason": "提高效率",
      "acceptanceCriteria": []
    },
    {
      "id": "US-03",
      "role": "未支付用户",
      "goal": "订单在30分钟内未支付时自动取消，释放占用的库存",
      "reason": "提高效率",
      "acceptanceCriteria": []
    },
    {
      "id": "US-04",
      "role": "下单用户",
      "goal": "在商家发货前可以随时取消订单，并立刻收到退款",
      "reason": "提高效率",
      "acceptanceCriteria": []
    },
    {
      "id": "US-05",
      "role": "已收货用户",
      "goal": "对不满意的商品申请退款，并能看到退款进度",
      "reason": "提高效率",
      "acceptanceCriteria": []
    },
    {
      "id": "US-06",
      "role": "收货用户",
      "goal": "只退订单中的部分商品，且金额能自动计算",
      "reason": "提高效率",
      "acceptanceCriteria": []
    },
    {
      "id": "US-07",
      "role": "已签收用户",
      "goal": "对购买的商品发布评价，帮助其他买家参考",
      "reason": "提高效率",
      "acceptanceCriteria": []
    },
    {
      "id": "US-08",
      "role": "运营专员",
      "goal": "在后台审核大额退款申请，确保退款合理",
      "reason": "提高效率",
      "acceptanceCriteria": []
    }
  ],
